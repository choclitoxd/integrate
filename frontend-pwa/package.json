{
  "name": "integrate-frontend-pwa",
  "private": true,
  "version": "0.1.0",
  "description": "PWA offline-first de Intégrate (Turista y Gestor de Enlace). Ver ADR-0004.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:quality": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/vitest-results.json",
    "quality:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "~5.103.2",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "~8.4.0",
    "uqr": "~0.1.3",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.7",
    "@types/node": "~24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.2",
    "@vitest/coverage-v8": "~5.0.3",
    "axe-core": "~4.13.0",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-jsx-a11y-x": "~0.2.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.5.7",
    "globals": "~17.13.0",
    "jsdom": "~30.1.2",
    "jsqr": "~1.4.0",
    "prettier": "~3.9.9",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "~8.3.2",
    "vitest": "~5.0.3"
  }
}
