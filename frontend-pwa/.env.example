# ==============================================================================
# Plantilla de variables de entorno de la PWA (SEC-DIR-004 · ADR-0004)
# Copiar a .env.development.local (ignorado por Git) y ajustar.
# Toda variable VITE_* se incrusta en el bundle público: NUNCA poner secretos aquí.
# ==============================================================================

# Base de la API REST. Obligatoria (la app no arranca sin ella).
# - Desarrollo: /api  → el proxy de Vite reenvía a VITE_DEV_API_PROXY_TARGET (cookie SameSite=Strict sin CORS).
# - Producción: URL absoluta del mismo sitio, p. ej. https://api.integrate.co
VITE_API_BASE_URL=/api

# Solo para `npm run dev`: destino del proxy /api (no llega al bundle).
VITE_DEV_API_PROXY_TARGET=http://localhost:8080
