# =============================================================================
# Intégrate · Plantilla de variables de entorno (ÚNICO archivo .env versionado)
# -----------------------------------------------------------------------------
#   cp infra/env/.env.example infra/env/.env.development   # luego reemplace los placeholders
# SEC-DIR-004: prohibido escribir aquí valores reales o credenciales funcionales.
# Producción NO usa archivos .env: AWS Secrets Manager / SSM Parameter Store.
# =============================================================================

# --- PostgreSQL 16 (contenedor) ----------------------------------------------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=YOUR_STRONG_SUPERUSER_PASSWORD_HERE

# Roles de login creados por infra/postgres/init/00_bootstrap.sql (1er arranque)
INTEGRATE_OWNER_PASSWORD=YOUR_STRONG_OWNER_PASSWORD_HERE
INTEGRATE_API_PASSWORD=YOUR_STRONG_API_PASSWORD_HERE
INTEGRATE_REPORTING_PASSWORD=YOUR_STRONG_REPORTING_PASSWORD_HERE

# --- Backend Spring Boot (runtime: rol integrate_api, solo DML) --------------
DATABASE_URL=jdbc:postgresql://localhost:5432/integrate
DATABASE_USERNAME=integrate_api
DATABASE_PASSWORD=SAME_VALUE_AS_INTEGRATE_API_PASSWORD
# Opcionales (valor por defecto en application.yml)
SERVER_PORT=8080
DB_POOL_MAX_SIZE=10

# --- Sesión JWT RS256 (ADR-0005 §2) ------------------------------------------
# Llave privada RSA-2048 PKCS#8 PEM en Base64 de una sola línea. Generarla en local con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
# y pegar la salida aquí en .env.development (nunca en este archivo ni en un commit).
JWT_SIGNING_KEY=PLACEHOLDER_BASE64_PKCS8_RSA_2048_PRIVATE_KEY
JWT_SIGNING_KEY_ID=session-dev-1

# --- Primer ADMIN (ADR-0005 §9, opcional) ------------------------------------
# Solo para el primer arranque; retirar después. Contraseña de 12 a 128 caracteres.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# --- Flyway (DDL: rol integrate_owner) ---------------------------------------
FLYWAY_USER=integrate_owner
FLYWAY_PASSWORD=SAME_VALUE_AS_INTEGRATE_OWNER_PASSWORD

# --- Almacenamiento S3 (LocalStack en local; perfil "storage") ---------------
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=integrate-vouchers-dev
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=LOCALSTACK_PLACEHOLDER_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=LOCALSTACK_PLACEHOLDER_SECRET_KEY

# --- Correo transaccional (Mailpit en local; perfil "mail") ------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
