# =============================================================================
# Intégrate · Plantilla de variables de entorno (ÚNICO archivo .env versionado)
# -----------------------------------------------------------------------------
#   cp infra/env/.env.example infra/env/.env.development   # luego reemplace los placeholders
# SEC-DIR-004: prohibido escribir aquí valores reales o credenciales funcionales.
# Producción NO usa archivos .env: AWS Secrets Manager / SSM Parameter Store.
# =============================================================================

# --- PostgreSQL 16 (contenedor) ----------------------------------------------
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=YOUR_STRONG_SUPERUSER_PASSWORD_HERE

# Roles de login creados por infra/postgres/init/00_bootstrap.sql (1er arranque)
INTEGRATE_OWNER_PASSWORD=YOUR_STRONG_OWNER_PASSWORD_HERE
INTEGRATE_API_PASSWORD=YOUR_STRONG_API_PASSWORD_HERE
INTEGRATE_REPORTING_PASSWORD=YOUR_STRONG_REPORTING_PASSWORD_HERE

# --- Backend Spring Boot (runtime: rol integrate_api, solo DML) --------------
DATABASE_URL=jdbc:postgresql://localhost:5432/integrate
DATABASE_USERNAME=integrate_api
DATABASE_PASSWORD=SAME_VALUE_AS_INTEGRATE_API_PASSWORD
# Opcionales (valor por defecto en application.yml)
SERVER_PORT=8080
DB_POOL_MAX_SIZE=10

# --- Sesión JWT RS256 (ADR-0005 §2) ------------------------------------------
# Llave privada RSA-2048 PKCS#8 PEM en Base64 de una sola línea. Generarla en local con:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
# y pegar la salida aquí en .env.development (nunca en este archivo ni en un commit).
JWT_SIGNING_KEY=PLACEHOLDER_BASE64_PKCS8_RSA_2048_PRIVATE_KEY
JWT_SIGNING_KEY_ID=session-dev-1

# --- Origen de la PWA (ADR-0014 §3) ------------------------------------------
# Base de los enlaces que viajan por correo (restablecer contraseña). En local, Vite.
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS (ADR-0005 §9, opcional) --------------------------------------------
# Vacío en local: el proxy de Vite hace las peticiones same-origin. En despliegue,
# el origen de la PWA, p. ej. https://app.integrate.co (separar varios con coma).
CORS_ALLOWED_ORIGINS=

# --- Datos sensibles AES-256-GCM (ADR-0007 §4) ------------------------------
# Llave de 32 bytes en Base64. Generarla en local con:  openssl rand -base64 32
# y pegarla en .env.development. Si se pierde, los datos de víctima cifrados son
# irrecuperables: respaldarla fuera de la base de datos.
SENSITIVE_DATA_KEY_V1=PLACEHOLDER_BASE64_32_BYTE_AES_KEY
SENSITIVE_DATA_KEY_CURRENT_VERSION=1

# --- Primer ADMIN (ADR-0005 §9, opcional) ------------------------------------
# Solo para el primer arranque; retirar después. Contraseña de 12 a 128 caracteres.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# --- Flyway (DDL: rol integrate_owner) ---------------------------------------
FLYWAY_USER=integrate_owner
FLYWAY_PASSWORD=SAME_VALUE_AS_INTEGRATE_OWNER_PASSWORD

# --- Almacenamiento S3 (LocalStack en local; perfil "storage") ---------------
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=integrate-vouchers-dev
# Bucket aparte para documentos que revelan la condición de víctima (ADR-0007 §5)
AWS_S3_SENSITIVE_BUCKET_NAME=integrate-sensitive-dev
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=LOCALSTACK_PLACEHOLDER_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=LOCALSTACK_PLACEHOLDER_SECRET_KEY

# --- Pagos (ADR-0009 §7) ------------------------------------------------------
# MOCK en dev/test; WOMPI en despliegue. Sin valor, el arranque aborta.
PAYMENT_PROVIDER=MOCK
# HMAC del webhook Mock: >= 32 bytes aleatorios en Base64 (p. ej. openssl rand -base64 32).
PAYMENT_WEBHOOK_SECRET_MOCK=YOUR_BASE64_32_BYTE_SECRET_HERE
# Wompi: obligatorios solo con PAYMENT_PROVIDER=WOMPI (Dashboard > Secretos para integración técnica).
# WOMPI_PUBLIC_KEY=pub_test_PLACEHOLDER
# WOMPI_INTEGRITY_SECRET=test_integrity_PLACEHOLDER
# WOMPI_EVENTS_SECRET=test_events_PLACEHOLDER
# Solo durante una rotación del secreto de eventos; retirar pasadas 25 h.
# WOMPI_EVENTS_SECRET_PREVIOUS=

# --- Vouchers (ADR-0010 §2) ---------------------------------------------------
# Llave RSA propia de vouchers (distinta de la de sesión): PKCS#8 PEM codificado en Base64, >= 2048 bits.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
VOUCHER_SIGNING_KEY=YOUR_BASE64_PKCS8_RSA_PRIVATE_KEY_HERE
# kid publicado en voucher.signing_keys; cambiarlo rota la llave (la anterior queda RETIRED).
VOUCHER_SIGNING_KEY_ID=voucher-dev-2026-10

# --- Correo transaccional (ADR-0011 §4; Mailpit en local, perfil "mail") -----
# Mailpit: gratuito, atrapa todos los correos y los muestra en http://localhost:8025 (sin credenciales).
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=Integrate <no-reply@integrate.local>
# Buzón real gratuito: Gmail SMTP con contraseña de aplicación (requiere verificación en dos pasos).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=tu.cuenta@gmail.com
#   SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
#   MAIL_FROM=Integrate <tu.cuenta@gmail.com>
# Relé gratuito para la demo: Brevo SMTP (300 correos/día, a cualquier destinatario, sin dominio propio).
#   El usuario es el "Login" de Brevo > SMTP & API > SMTP (no el correo de la cuenta) y la clave es una
#   "SMTP key" generada ahí. MAIL_FROM debe ser un remitente verificado en Brevo > Senders.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_AUTH=true
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=YOUR_BREVO_SMTP_LOGIN_HERE
#   SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY_HERE
#   MAIL_FROM=Integrate <remitente.verificado@ejemplo.com>

# =============================================================================
# Despliegue de DEMO: SnapDeploy (ADR-0026) o PC propio + Cloudflare Tunnel (ADR-0025) · docs/despliegue/demo-gratuita.md
# -----------------------------------------------------------------------------
#   cp infra/env/.env.example infra/env/.env.demo   # y reemplace TODOS los valores de abajo
# .env.demo es local (ignorado por Git): no lo comitee ni lo deje en una carpeta sincronizada pública.
# Use llaves NUEVAS, distintas de las de .env.development. Valores para la demo (los de las secciones
# anteriores que no se repiten aquí se mantienen, p. ej. SENSITIVE_DATA_KEY_CURRENT_VERSION):
#   DATABASE_URL=jdbc:postgresql://ep-xxxx.REGION.aws.neon.tech/integrate?sslmode=require   (host directo, sin -pooler)
#   DATABASE_USERNAME=integrate_api            DATABASE_PASSWORD=<la de integrate_api en Neon>
#   FLYWAY_USER=integrate_owner                FLYWAY_PASSWORD=<la de integrate_owner en Neon>
#   DB_POOL_MAX_SIZE=5
#   FRONTEND_BASE_URL=https://TU-PROYECTO.pages.dev    CORS_ALLOWED_ORIGINS=   (vacío: Pages reenvía /api)
#   PAYMENT_PROVIDER=MOCK                      (con el túnel quick, la URL cambia: no use Wompi)
#   AWS_ENDPOINT_URL=https://s3.REGION.backblazeb2.com  AWS_REGION=REGION
#   AWS_S3_BUCKET_NAME=YOUR_B2_VOUCHERS_BUCKET   AWS_S3_SENSITIVE_BUCKET_NAME=YOUR_B2_SENSITIVE_BUCKET
#   AWS_ACCESS_KEY_ID=YOUR_B2_KEY_ID           AWS_SECRET_ACCESS_KEY=YOUR_B2_APPLICATION_KEY
#   SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_AUTH=true SMTP_STARTTLS=true   (+ SMTP_USERNAME/SMTP_PASSWORD de Brevo)
#   (NO defina SPRING_PROFILES_ACTIVE=dev: cargaría el seed de desarrollo)
# SnapDeploy (ADR-0026, camino A): se cargan las MISMAS variables de arriba en el panel del contenedor
# (sin TUNNEL_TOKEN). No hay gestor de secretos: son visibles para quien entre a la cuenta. Solo demo,
# sin datos reales, llaves nuevas, 2FA. Este archivo (.env.demo) sirve solo como lista local para copiarlas.
# Solo compose.demo.yml (infra/docker/, camino B):
# Memoria para 512 MB / 0,25 vCPU (SnapDeploy Free). Ya es el valor por defecto de la imagen; solo sobrescríbalo si cambia el plan:
#   JAVA_TOOL_OPTIONS=-Xmx144m -XX:MaxMetaspaceSize=144m -Xss228k -XX:ReservedCodeCacheSize=40m -XX:MaxDirectMemorySize=32m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=30
#   DB_POOL_MAX_SIZE=4
#   SERVER_TOMCAT_THREADS_MAX=16
# Token del túnel con dominio (perfil "named"): Zero Trust > Networks > Tunnels > su túnel > Token.
# Es un SECRETO: si se filtra, revóquelo en el panel de Cloudflare. El perfil "quick" no lo necesita.
TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE_ONLY_FOR_NAMED_PROFILE
# Etiqueta de la imagen local de la API (opcional)
# API_IMAGE_TAG=demo
