{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/victx/AppData/Roaming/uv/tools/graphifyy/Scripts/python.exe -m graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/victx/AppData/Roaming/uv/tools/graphifyy/Scripts/python.exe -m graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}