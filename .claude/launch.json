{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-pwa",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend-pwa", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-pwa-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend-pwa", "run", "dev", "--", "--port", "5174"],
      "port": 5174
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c", "backend-api\\mvnw.cmd", "-o", "-q", "-f", "backend-api\\pom.xml", "spring-boot:run",
        "-Dspring-boot.run.profiles=dev",
        "-Dspring-boot.run.arguments=--server.port=8081"
      ],
      "port": 8081
    },
    {
      "name": "backend-api-mailpit",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c", "backend-api\\mvnw.cmd", "-o", "-q", "-f", "backend-api\\pom.xml", "spring-boot:run",
        "-Dspring-boot.run.profiles=dev",
        "-Dspring-boot.run.arguments=--server.port=8081 --spring.mail.host=localhost --spring.mail.port=587 --spring.mail.username= --spring.mail.password= --spring.mail.properties.mail.smtp.auth=false --spring.mail.properties.mail.smtp.starttls.enable=false --spring.mail.properties.mail.smtp.starttls.required=false"
      ],
