# Todo el texto se guarda en LF en el repositorio y en la copia de trabajo,
# sin importar core.autocrlf de cada máquina: evita archivos "modificados"
# solo por finales de línea y que Prettier marque CRLF.
* text=auto eol=lf

# Scripts que se ejecutan dentro de contenedores Linux: siempre LF.
*.sh  text eol=lf
*.sql text eol=lf

# Maven Wrapper (ADR-0002): script POSIX en LF, script Windows en CRLF.
mvnw     text eol=lf
*.cmd    text eol=crlf
